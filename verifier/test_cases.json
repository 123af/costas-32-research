    {
      "id": "invalid_empty",
      "category": "invalid_input",
      "input": [],
      "expected": {
        "valid_input": false,
        "is_permutation": false,
        "is_costas": false,
        "order": 0,
        "error_code": "empty_permutation"
      }
    },
