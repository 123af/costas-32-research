{
  "marker": "COSTAS_TEST_CASES_V1",
  "schema_version": 1,
  "indexing": "1-based",
  "coordinate_convention": "(i, permutation[i]) with i in {1,...,n}",
  "difference_convention": "For each fixed d>0, permutation[i+d]-permutation[i] must be unique.",
  "cases": [
    {
      "id": "valid_n1_identity",
      "category": "valid_costas",
      "input": [
        1
      ],
      "expected": {
        "valid_input": true,
        "is_permutation": true,
        "is_costas": true,
        "order": 1
      }
    },
    {
      "id": "valid_n2_identity",
      "category": "valid_costas",
      "input": [
        1,
        2
      ],
      "expected": {
        "valid_input": true,
        "is_permutation": true,
        "is_costas": true,
        "order": 2
      }
    },
    {
      "id": "valid_n2_reverse",
      "category": "valid_costas",
      "input": [
        2,
        1
      ],
      "expected": {
        "valid_input": true,
        "is_permutation": true,
        "is_costas": true,
        "order": 2
      }
    },
