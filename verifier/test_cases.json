    {
      "id": "not_costas_n3_identity",
      "category": "permutation_but_not_costas",
      "input": [
        1,
        2,
        3
      ],
      "expected": {
        "valid_input": true,
        "is_permutation": true,
        "is_costas": false,
        "order": 3,
        "must_report_collision": {
          "vector": [
            1,
            1
          ],
          "point_pairs": [
            [
              [
                1,
                1
              ],
              [
                2,
                2
              ]
            ],
            [
              [
                2,
                2
              ],
              [
                3,
                3
              ]
            ]
          ]
        }
      }
    },
